def decimal_to_hex(decimal_value):
 hex_digits = "0123456789ABCDEF"
 hexadecimal = ""
 while decimal_value > 0:
 remainder = decimal_value % 16
 hexadecimal = hex_digits[remainder] + hexadecimal
 decimal_value = decimal_value // 16
 return hexadecimal
